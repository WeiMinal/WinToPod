<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <AssemblyName>WinToPod</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Brand/WinToPod.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/DeviceIcons/*.svg" LogicalName="WinToPod.DeviceIcons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Brand/*.ico;Assets/Brand/*.png" Exclude="Assets/Brand/*-source.png" LogicalName="WinToPod.Brand.%(Filename)%(Extension)" />
    <ProjectReference Include="../WinToPod.AirPlay/WinToPod.AirPlay.csproj" />
    <ProjectReference Include="../WinToPod.Core/WinToPod.Core.csproj" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
</Project>
