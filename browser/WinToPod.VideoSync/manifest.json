{
  "manifest_version": 3,
  "name": "WinToPod 音画补偿助手",
  "version": "1.1.0",
  "description": "安装后B站自动跟随WinToPod音箱连接，无需填写延迟。其他网站可单独授权。",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:38765/*",
    "https://*.bilibili.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/WinToPod-black-16.png",
      "32": "icons/WinToPod-black-32.png",
      "48": "icons/WinToPod-black-48.png",
      "128": "icons/WinToPod-black-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/WinToPod-black-16.png",
    "32": "icons/WinToPod-black-32.png",
    "48": "icons/WinToPod-black-48.png",
    "128": "icons/WinToPod-black-128.png"
  }
}
